<Layouts.flash_group flash={@flash} />
<%!-- hero --%>
<section class="relative min-h-[70vh] flex items-center bg-black overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/images/robotics.webp"
      alt="Logistics background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-linear-to-r from-black via-black/90 to-transparent"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-white leading-tight">
        Parcel Handling <br class="hidden sm:block" /> Made Easy
      </h1>

      <p class="mt-4 text-lg sm:text-xl text-gray-200 leading-relaxed max-w-xl">
        Your one-stop-shop for parcel handling.
      </p>

      <div class="mt-10 max-w-xl">
        <div class="relative">
          <input
            type="text"
            placeholder="Enter your tracking number(s)"
            class="w-full rounded-md border border-gray-200 bg-white px-6 py-4 pr-40 text-base text-gray-900 placeholder-gray-500 outline-none focus:outline-none"
          />

          <button class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-md bg-red-700 px-6 py-3 text-sm font-semibold text-white hover:bg-red-800 transition">
            Search
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<%!-- about swiftly --%>
<section class="py-10 bg-white">
  <div class="container mx-auto px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
    <figure>
      <img
        src="/images/parcel.svg"
        alt="Supply chain platform overview"
        class="w-full h-auto object-cover"
        width="364"
        height="305"
        decoding="async"
        fetchpriority="high"
        oncontextmenu="return false"
      />
    </figure>

    <div>
      <h2 class="text-3xl font-semibold text-gray-900">
        What is Swiftly?
      </h2>

      <p class="mt-4 text-gray-700 text-base leading-relaxed">
        Swiftly is a transport technology system by Codecraft  Ventures that provides end-to-end solutions for transport operators and users.
      </p>

      <div class="mt-6 flex gap-4">
        <a
          href="/sign-in"
          class="font-medium text-base bg-red-700 text-white rounded-md  px-6 py-2 hover:bg-red-800 hover:text-white transition-colors duration-300"
        >
          Explore Swiftly
        </a>
      </div>
    </div>
  </div>
</section>

<%!-- cta --%>
<%!-- <section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-md bg-gray-100 px-6 py-8  lg:flex lg:items-center lg:gap-x-16 lg:px-12">
      <div class="max-w-xl text-center lg:text-left">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 sm:text-3xl">
          A Million Dollar Solution. ZERO UPFRONT FEES.
        </h2>
        <p class="mt-3 text-sm text-gray-600 sm:text-base">
          A solution that would cost millions of dollars availed at ZERO UPFRONT FEES.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a
            href="#"
            class="font-medium text-base bg-red-700 text-white rounded-md  px-6 py-2 hover:bg-red-800 hover:text-white transition-colors duration-300"
          >
            Get started
          </a>

          <a
            href="#"
            class="font-medium text-base bg-gray-100 text-gray-900 rounded-md  px-6 py-2 hover:bg-gray-400 hover:text-gray-900 transition-colors duration-300"
          >
            View features
          </a>
        </div>
      </div>


      <div class=" relative mt-8 flex-1 lg:mt-0">
        <img
          src="/images/parcel.svg"
          alt="Parcel tracking dashboard"
          width="800"
          height="500"
          class="w-full h-auto rounded-lg ring-1 ring-gray-200"
          fetchpriority="high"
          decoding="async"
          oncontextmenu="return false;"
        />
      </div>
    </div>
  </div>
</section> --%>

<%!-- Footer --%>
<footer class="bg-white text-gray-700">
  <div class="mx-auto max-w-7xl px-6 py-12 grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-5">
    <aside class="md:col-span-2 space-y-4">
      <span class="text-4xl tracking-tight text-gray-900 font-extrabold mb-4">
        <a href={~p"/"} class="flex items-center gap-1">
          <img
            src={~p"/images/favicon.webp"}
            alt="Swiftly  logo"
            class="h-10 w-auto"
            width="299"
            height="224"
            decoding="async"
            fetchpriority="high"
            oncontextmenu="return false;"
          />
        </a>
      </span>

      <p class="text-sm leading-relaxed">
        <span class="font-semibold text-gray-900"></span> <br /> Track.Move.Deliver
      </p>
    </aside>

    <nav class="space-y-3">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-900">Company</h3>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href={~p"/"}
            class="relative inline-block
            after:absolute after:left-0 after:-bottom-1
            after:h-0.5 after:w-full
            after:origin-left after:scale-x-0
            after:bg-red-700
            after:transition-transform after:duration-300 after:ease-out
            hover:after:scale-x-100"
          >
            About us
          </a>
        </li>
        <li>
          <a
            href={~p"/"}
            class="relative inline-block
            after:absolute after:left-0 after:-bottom-1
            after:h-0.5 after:w-full
            after:origin-left after:scale-x-0
            after:bg-red-700
            after:transition-transform after:duration-300 after:ease-out
            hover:after:scale-x-100"
          >
            Blog
          </a>
        </li>
      </ul>
    </nav>

    <nav class="space-y-3">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-900">Legal</h3>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            href={~p"/"}
            class="relative inline-block
            after:absolute after:left-0 after:-bottom-1
            after:h-0.5 after:w-full
            after:origin-left after:scale-x-0
            after:bg-red-700
            after:transition-transform after:duration-300 after:ease-out
            hover:after:scale-x-100"
          >
            Terms of use
          </a>
        </li>
        <li>
          <a
            href={~p"/"}
            class="relative inline-block
            after:absolute after:left-0 after:-bottom-1
            after:h-0.5 after:w-full
            after:origin-left after:scale-x-0
            after:bg-red-700
            after:transition-transform after:duration-300 after:ease-out
            hover:after:scale-x-100"
          >
            Privacy policy
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
