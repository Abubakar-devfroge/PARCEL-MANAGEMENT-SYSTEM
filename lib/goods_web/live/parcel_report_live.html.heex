<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="border border-gray-200 bg-white shadow-sm rounded-sm">
      
<!-- Header -->
      <div class="border-b border-gray-200 px-4 py-3 sm:px-6">
        <h1 class="text-xl font-semibold text-gray-900">Reports</h1>
      </div>
      
<!-- Tabs -->
      <div class="border-b border-gray-200 bg-gray-50 px-4 py-2 sm:px-6">
        <div class="flex items-center gap-6 border-b border-gray-200">
          <.link patch={~p"/parcel_reports?tab=summary"} class={tab_class(@active_tab, "summary")}>
            Summary
          </.link>

          <.link
            patch={~p"/parcel_reports?tab=analytics"}
            class={tab_class(@active_tab, "analytics")}
          >
            Analytics
          </.link>

          <.link
            patch={~p"/parcel_reports?tab=customers"}
            class={tab_class(@active_tab, "customers")}
          >
            Customers
          </.link>

          <.link
            patch={~p"/parcel_reports?tab=financial"}
            class={tab_class(@active_tab, "financial")}
          >
            Financial
          </.link>

          <.link
            patch={~p"/parcel_reports?tab=shipments"}
            class={tab_class(@active_tab, "shipments")}
          >
            Shipments
          </.link>
        </div>
      </div>
      
<!-- SUMMARY -->
      <section :if={@active_tab == "summary"} class="px-4 py-4 sm:px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700">
          Summary
        </h2>

        <div class="mt-4 overflow-x-auto border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <tbody class="divide-y divide-gray-200 bg-white">
              <tr>
                <th class="w-1/3 bg-gray-50 px-4 py-3 text-left font-medium text-gray-700">
                  All Shipments
                </th>
                <td class="px-4 py-3">{@all_bookings_count}</td>
              </tr>
              <tr>
                <th class="bg-gray-50 px-4 py-3 text-left font-medium text-gray-700">
                  Filtered Shipments
                </th>
                <td class="px-4 py-3">{@filtered_bookings_count}</td>
              </tr>
              <tr>
                <th class="bg-gray-50 px-4 py-3 text-left font-medium text-gray-700">
                  Pending Value
                </th>
                <td class="px-4 py-3">
                  KES {decimal_to_money(@report_data.financial_reports.pending_payments_amount)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        
<!-- Alerts -->
        <div class="mt-4">
          <div
            :for={alert <- @alerts}
            class={["mb-2 border px-4 py-3 text-sm font-medium", alert_class(alert.level)]}
          >
            {alert.message}
          </div>
        </div>
      </section>
      
<!-- ANALYTICS -->
      <section :if={@active_tab == "analytics"} class="px-4 py-4 sm:px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700">
          Visual Analytics
        </h2>

        <div class="mt-4 border border-gray-200 p-4">
          <canvas id="chart-shipments-trend" height="130"></canvas>
        </div>
      </section>
      
<!-- CUSTOMERS -->
      <section :if={@active_tab == "customers"} class="px-4 py-4 sm:px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700">
          Customer Leaders
        </h2>

        <div class="mt-4 overflow-x-auto border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Sender</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Phone</th>
                <th class="px-4 py-3 text-right font-medium text-gray-700">Shipments</th>
                <th class="px-4 py-3 text-right font-medium text-gray-700">Revenue</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <tr :for={row <- @report_data.customer_reports.top_customers}>
                <td class="px-4 py-3">{row.sender_name}</td>
                <td class="px-4 py-3">{row.sender_phone}</td>
                <td class="px-4 py-3 text-right">{row.total_shipments}</td>
                <td class="px-4 py-3 text-right">
                  KES {decimal_to_money(row.total_revenue)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      
<!-- FINANCIAL -->
      <section :if={@active_tab == "financial"} class="px-4 py-4 sm:px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700">
          Financial Performance
        </h2>

        <div class="mt-4 overflow-x-auto border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <tbody class="divide-y divide-gray-200 bg-white">
              <tr>
                <th class="w-1/2 bg-gray-50 px-4 py-3 text-left font-medium text-gray-700">
                  Pending Payments
                </th>
                <td class="px-4 py-3">
                  {@report_data.financial_reports.pending_payments_count}
                </td>
              </tr>
              <tr>
                <th class="bg-gray-50 px-4 py-3 text-left font-medium text-gray-700">
                  Pending Amount
                </th>
                <td class="px-4 py-3">
                  KES {decimal_to_money(@report_data.financial_reports.pending_payments_amount)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      
<!-- SHIPMENTS -->
      <section :if={@active_tab == "shipments"} class="px-4 py-4 sm:px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-700">
          Shipment Details
        </h2>

        <div class="mt-4 overflow-x-auto border border-gray-200">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Parcel</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Sender</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Receiver</th>
                <th class="px-4 py-3 text-left font-medium text-gray-700">Destination</th>
                <th class="px-4 py-3 text-right font-medium text-gray-700">Qty</th>
                <th class="px-4 py-3 text-right font-medium text-gray-700">Price</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <tr :for={{id, booking} <- @streams.custom_rows} id={id}>
                <td class="px-4 py-3">{booking.parcel_number}</td>
                <td class="px-4 py-3">{booking.sender_name}</td>
                <td class="px-4 py-3">{booking.receiver_name}</td>
                <td class="px-4 py-3">{booking.destination}</td>
                <td class="px-4 py-3 text-right">{booking.quantity}</td>
                <td class="px-4 py-3 text-right">
                  KES {decimal_to_money(booking.price)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>
