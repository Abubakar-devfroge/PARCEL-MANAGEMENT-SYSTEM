<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 space-y-6">
    <!-- Header Area -->
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">Reports & Analytics</h1>
        <p class="text-sm text-gray-500">Overview of system performance and shipment metrics.</p>
      </div>
      <div class="flex items-center gap-2">
        <div class="text-right hidden sm:block">
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Last Sync</p>
          <p class="text-sm font-semibold text-gray-900">
            {Calendar.strftime(@last_updated_at, "%I:%M %p")}
          </p>
        </div>
        <div class="h-8 w-px bg-gray-200 mx-2"></div>
        <.button
          phx-click="reset_filters"
          variant="primary"

        >
          <.icon name="hero-arrow-path" class="size-4" /> Reset
        </.button>
      </div>
    </div>
    
<!-- Top Filters Bar (Prominent & Non-reloading) -->
    <div class="rounded-sm border border-gray-200 bg-gray-50 p-4 shadow-sm">
      <.form
        for={%{}}
        as={:filters}
        phx-change="filter"
        phx-submit="filter"
        class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 items-end"
      >
        <div class="space-y-1.5 focus-within:text-red-600 transition-colors">
          <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
            Search Records
          </label>
          <div class="relative group">
            <.icon
              name="hero-magnifying-glass"
              class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-gray-400 group-focus-within:text-red-500 transition-colors"
            />
            <input
              type="text"
              name="filters[query]"
              value={@filters.query}
              placeholder="Ref #, sender, receiver..."
              class="w-full rounded-lg border-gray-200 pl-9 pr-4 py-2 text-sm focus:border-red-500 focus:ring-red-500 placeholder:text-gray-400"
              phx-debounce="300"
            />
          </div>
        </div>

        <div class="space-y-1.5 cursor-pointer">
          <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
            From Date
          </label>
          <input
            type="date"
            name="filters[date_from]"
            value={@filters.date_from}
            class="w-full rounded-lg border-gray-200 py-2 text-sm focus:border-red-500 focus:ring-red-500"
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
            To Date
          </label>
          <input
            type="date"
            name="filters[date_to]"
            value={@filters.date_to}
            class="w-full rounded-lg border-gray-200 py-2 text-sm focus:border-red-500 focus:ring-red-500"
          />
        </div>

        <div class="space-y-1.5">
          <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
            Parcel Type
          </label>
          <select
            name="filters[parcel_type]"
            class="w-full rounded-lg border-gray-200 py-2 text-sm focus:border-red-500 focus:ring-red-500"
          >
            <option value="">All Types</option>
            <option value="Box" selected={@filters.parcel_type == "Box"}>Box</option>
            <option value="Envelope" selected={@filters.parcel_type == "Envelope"}>
              Envelope
            </option>
            <option value="Other" selected={@filters.parcel_type == "Other"}>Other</option>
          </select>
        </div>
      </.form>
    </div>
    
<!-- KPI Stats -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-sm border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="rounded-lg bg-gray-100 p-2 text-gray-600">
            <.icon name="hero-cube" class="size-5" />
          </div>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
            Total Shipments
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-2xl font-bold text-gray-900">{@all_bookings_count}</span>
          <span class="text-xs font-medium text-emerald-600">Active</span>
        </div>
      </div>

      <div class="rounded-sm border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="rounded-lg bg-red-50 p-2 text-red-600">
            <.icon name="hero-banknotes" class="size-5" />
          </div>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
            Revenue
          </span>
        </div>
        <div class="mt-3">
          <span class="text-sm font-bold text-gray-400 mr-1">KES</span>
          <span class="text-2xl font-bold text-gray-900">
            {decimal_to_money(@report_data.financial_reports.pending_payments_amount)}
          </span>
        </div>
      </div>

      <div class="rounded-sm border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="rounded-lg bg-gray-100 p-2 text-gray-600">
            <.icon name="hero-clock" class="size-5" />
          </div>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Today</span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-gray-900">
            {@report_data.parcel_activity.daily_shipments}
          </span>
          <span class="text-xs text-gray-400 ml-1">bookings</span>
        </div>
      </div>

      <div class="rounded-sm border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="rounded-lg bg-gray-100 p-2 text-gray-600">
            <.icon name="hero-chart-bar" class="size-5" />
          </div>
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
            Return Rate
          </span>
        </div>
        <div class="mt-3">
          <span class="text-2xl font-bold text-gray-900">0%</span>
          <span class="text-xs text-gray-400 ml-1">healthy</span>
        </div>
      </div>
    </div>
    
<!-- Main Content Tabs -->
    <div class="border-b border-gray-200">
      <nav class="flex gap-8 -mb-px">
        <.link
          patch={~p"/parcel_reports?tab=summary"}
          class={tab_link_class(@active_tab, "summary")}
        >
          Overview
        </.link>
        <.link
          patch={~p"/parcel_reports?tab=analytics"}
          class={tab_link_class(@active_tab, "analytics")}
        >
          Analytics
        </.link>
        <.link
          patch={~p"/parcel_reports?tab=customers"}
          class={tab_link_class(@active_tab, "customers")}
        >
          Top Clients
        </.link>
        <.link
          patch={~p"/parcel_reports?tab=shipments"}
          class={tab_link_class(@active_tab, "shipments")}
        >
          Shipments
        </.link>
      </nav>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Main Content (2/3) -->
      <div class="lg:col-span-2 space-y-6">
        <%= if @active_tab == "summary" do %>
          <div class="rounded-sm border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Booking Flow</h2>
            <div class="h-[300px] w-full">
              <canvas
                id="summary-chart-main"
                phx-hook="ChartHook"
                data-payload={@chart_payload}
                data-type="line"
                phx-update="ignore"
              >
              </canvas>
            </div>
          </div>
        <% end %>

        <%= if @active_tab == "analytics" do %>
          <div class="rounded-sm border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-gray-900 mb-6">Revenue Breakdown</h2>
            <div class="h-[300px] w-full">
              <canvas
                id="analytics-chart-main"
                phx-hook="ChartHook"
                data-payload={@chart_payload}
                data-type="bar"
                phx-update="ignore"
              >
              </canvas>
            </div>
          </div>
        <% end %>

        <%= if @active_tab == "customers" do %>
          <div class="rounded-sm border border-gray-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-gray-200 px-6 py-4 bg-gray-50/50">
              <h2 class="text-sm font-bold text-gray-900 uppercase tracking-widest">
                Top Ranking Customers
              </h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="border-b border-gray-100 text-gray-400 font-bold uppercase text-[10px] tracking-widest">
                    <th class="px-6 py-4">Customer</th>
                    <th class="px-6 py-4">Volume</th>
                    <th class="px-6 py-4 text-right">Net Revenue</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  <tr
                    :for={row <- @report_data.customer_reports.top_customers}
                    class="hover:bg-gray-50 transition-colors"
                  >
                    <td class="px-6 py-4">
                      <div class="font-bold text-gray-900">{row.sender_name}</div>
                      <div class="text-xs text-gray-500">{row.sender_phone}</div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-gray-700">{row.total_shipments}</span>
                        <div class="h-1.5 w-16 rounded-full bg-gray-100 overflow-hidden">
                          <div
                            class="h-full bg-red-500"
                            style={"width: #{min(row.total_shipments * 8, 100)}%"}
                          >
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-right font-bold text-gray-900">
                      KES {decimal_to_money(row.total_revenue)}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <%= if @active_tab == "shipments" do %>
          <div class="rounded-sm border border-gray-200 bg-white shadow-sm overflow-hidden">
            <div class="border-b border-gray-200 px-6 py-4 bg-gray-50/50">
              <h2 class="text-sm font-bold text-gray-900 uppercase tracking-widest">
                Shipment Registry
              </h2>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="border-b border-gray-100 text-gray-400 font-bold uppercase text-[10px] tracking-widest">
                    <th class="px-6 py-4">Ref # & Type</th>
                    <th class="px-6 py-4">Destination</th>
                    <th class="px-6 py-4 text-right">Price</th>
                  </tr>
                </thead>
                <tbody id="shipment-body" phx-update="stream" class="divide-y divide-gray-50">
                  <tr
                    :for={{id, booking} <- @streams.custom_rows}
                    id={id}
                    class="hover:bg-gray-50"
                  >
                    <td class="px-6 py-4">
                      <div class="font-bold text-gray-900">{booking.parcel_number}</div>
                      <div class="text-xs text-gray-400">{booking.parcel_type}</div>
                    </td>
                    <td class="px-6 py-4 text-gray-600 font-medium">{booking.destination}</td>
                    <td class="px-6 py-4 text-right font-bold text-gray-900 italic">
                      {decimal_to_money(booking.price)}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
      
<!-- Side Data (1/3) -->
      <div class="space-y-6">
        <div class="rounded-sm border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">
            Route Popularity
          </h3>
          <div class="space-y-4">
            <div
              :for={route <- Enum.take(@report_data.operational_reports.route_counts, 5)}
              class="group"
            >
              <div class="flex justify-between text-xs mb-1.5">
                <span class="font-bold text-gray-700">{route.destination}</span>
                <span class="text-gray-400">{route.total_routes} trips</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-gray-100">
                <div
                  class="h-full rounded-full bg-gray-900 transition-all group-hover:bg-red-500"
                  style={"width: #{min(route.total_routes * 12, 100)}%"}
                >
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <div
            :for={alert <- @alerts}
            class={[
              "flex gap-3 rounded-sm p-4 border",
              alert.level == :warning && "bg-amber-50 border-amber-100 text-amber-900",
              alert.level == :info && "bg-gray-50 border-gray-200 text-gray-600"
            ]}
          >
            <.icon
              name={
                if(alert.level == :warning,
                  do: "hero-exclamation-triangle",
                  else: "hero-information-circle"
                )
              }
              class="size-5 shrink-0"
            />
            <p class="text-xs font-medium">{alert.message}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
