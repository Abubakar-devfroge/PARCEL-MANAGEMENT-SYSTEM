<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-xl font-semibold text-gray-900">Employees</h1>
      </div>

      <button
        id="add-employee-btn"
        type="button"
        phx-click="open_add_modal"
        class="inline-flex items-center justify-center rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-600"
      >
        Add Employee
      </button>
    </div>

    <div class="border border-gray-200 bg-white rounded-none shadow-md">
      <div class="border-b border-gray-200 bg-gray-50 px-4 py-3 sm:px-6">
        <form id="employee-search-form" phx-change="search" class="w-full">
          <.input
            name="search[q]"
            value={@search_query}
            type="search"
            placeholder="Search employees by name or email"
            phx-debounce="250"
          />
        </form>
      </div>

      <%= if @employees_count == 0 do %>
        <div class="flex flex-col items-center justify-center px-4 py-14 text-center text-gray-500 sm:px-6">
          <p class="text-sm font-semibold text-gray-700">No employees found</p>
          <p class="mt-1 text-sm text-gray-500">
            Create your first admin or agent from the button above.
          </p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-gray-700">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide sm:px-6">
                  Name
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide sm:px-6">
                  Email
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide sm:px-6">
                  Role
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide sm:px-6">
                  Created At
                </th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide sm:px-6">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody
              id="employees"
              phx-update="stream"
              class="divide-y divide-gray-200 bg-white text-gray-900"
            >
              <tr
                :for={{id, employee} <- @streams.employees}
                id={id}
                class="hover:bg-gray-50 transition-colors"
              >
                <td class="px-4 py-3 whitespace-nowrap sm:px-6">{employee.name || "-"}</td>
                <td class="px-4 py-3 whitespace-nowrap sm:px-6">{employee.email}</td>
                <td class="px-4 py-3 whitespace-nowrap sm:px-6">
                  <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">
                    {employee.role}
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap sm:px-6">
                  {format_datetime(employee.inserted_at)}
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-right sm:px-6">
                  <span class="text-xs text-gray-500">Invite sent</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <%= if @show_add_modal do %>
      <div class="fixed inset-0 z-50">
        <button
          type="button"
          phx-click="close_add_modal"
          class="absolute inset-0 bg-gray-500/75"
          aria-label="Close modal"
        >
        </button>

        <div class="relative flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
          <div class="relative w-full max-w-lg overflow-hidden rounded-lg bg-white text-left sm:my-8">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
              <h3 class="text-base font-semibold text-gray-900">Add Employee</h3>
              <p class="mt-1 text-sm text-gray-500">
                Create an admin or agent account and send a secure invite email.
              </p>

              <.form
                for={@employee_form}
                id="employee-form"
                phx-change="validate_employee"
                phx-submit="create_employee"
                class="mt-4"
              >
                <.input field={@employee_form[:name]} label="Name" required />
                <.input field={@employee_form[:email]} label="Email" type="email" required />
                <.input
                  field={@employee_form[:role]}
                  type="select"
                  label="Role"
                  options={[{"Admin", "admin"}, {"Agent", "agent"}]}
                  required
                />

                <div class="mt-4 flex justify-end gap-3">
                  <button
                    type="button"
                    phx-click="close_add_modal"
                    class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 inset-ring inset-ring-gray-300 hover:bg-gray-50"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    class="rounded-md bg-gray-900 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-600"
                  >
                    Create Employee
                  </button>
                </div>
              </.form>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
