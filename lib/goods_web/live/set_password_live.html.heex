<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-lg px-4 py-10 sm:px-6 lg:px-8">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h1 class="text-xl font-semibold text-gray-900">Set Your Password</h1>

      <%= if @token_status == :valid do %>
        <p class="mt-2 text-sm text-gray-600">
          Set a secure password for <span class="font-medium text-gray-800">{@invitee_email}</span>.
        </p>

        <.form
          for={@password_form}
          id="set-password-form"
          phx-change="validate"
          phx-submit="save"
          class="mt-4"
        >
          <.input
            field={@password_form[:password]}
            type="password"
            label="New Password"
            required
            minlength="8"
          />
          <.input
            field={@password_form[:password_confirmation]}
            type="password"
            label="Confirm Password"
            required
            minlength="8"
          />

          <button
            type="submit"
            class="mt-3 w-full rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-600"
          >
            Save Password
          </button>
        </.form>
      <% else %>
        <p class="mt-3 text-sm text-gray-600">
          <%= case @token_status do %>
            <% :missing -> %>
              Missing invite token.
            <% :invalid -> %>
              Invalid invite token.
            <% :expired -> %>
              This invite token has expired.
            <% _ -> %>
              This invite token cannot be used.
          <% end %>
        </p>

        <.link
          navigate={~p"/sign-in"}
          class="mt-5 inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-600"
        >
          Back to Sign in
        </.link>
      <% end %>
    </div>
  </div>
</Layouts.app>
