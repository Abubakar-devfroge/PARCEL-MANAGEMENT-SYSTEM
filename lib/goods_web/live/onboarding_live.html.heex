<Layouts.app flash={@flash}>
  <section class="min-h-screen bg-white px-4 py-8 sm:px-6 lg:px-8">
    <div
      :if={@show_cancel_warning}
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
    >
      <button
        type="button"
        phx-click="continue_onboarding"
        class="absolute inset-0 bg-black/40"
        aria-label="Close cancel onboarding dialog"
      >
      </button>

      <div class="relative z-10 w-full max-w-md rounded-md border border-amber-300 bg-white p-6">
        <h2 class="text-base font-semibold text-amber-900">Cancel Onboarding?</h2>
        <p class="mt-2 text-sm text-amber-800">
          Your onboarding progress may be incomplete. If you cancel now, you will be signed out.
        </p>

        <div class="mt-5 flex flex-wrap justify-end gap-3">
          <.button
            type="button"
            phx-click="continue_onboarding"
          >
            Continue Onboarding
          </.button>
          <button
            type="button"
            phx-click="confirm_cancel_onboarding"
            class="inline-flex items-center rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50"
          >
            Yes, Cancel
          </button>
        </div>
      </div>
    </div>

    <div class="mx-auto w-full max-w-6xl pb-4">
      <img
        src={~p"/images/logo1.svg"}
        class="h-10 w-auto"
        alt="Parcel Tracker logo"
        width="160"
        height="40"
      />
    </div>

    <div class="mx-auto w-full max-w-6xl overflow-hidden rounded-md bg-white lg:grid lg:grid-cols-2">
      <div>
        <div class="hidden lg:flex lg:flex-col lg:justify-between bg-white text-gray-900 p-8">
          <div>
            <h2 class="mt-8 text-3xl font-semibold leading-tight ">Welcome to Parcel Tracker</h2>
            <p class="mt-3 text-sm ">
              Set up your business profile once and start managing parcel bookings with confidence.
            </p>
          </div>

          <div class="mt-8 rounded-md border border-white/20 bg-white/10 p-4">
            <img
              src={~p"/images/onboard.svg"}
              class="w-full h-80 rounded-sm"
              alt="Onboarding illustration"
              width="560"
              height="380"
            />
          </div>
        </div>
      </div>

      <div class="px-6 py-6 sm:px-8">
        <.form
          for={@form}
          id="onboarding-form"
          phx-change="validate"
          phx-submit="save"
          class="space-y-5"
        >
          <div class="grid grid-cols-1 gap-5">
            <.input field={@form[:company_name]} type="text" label="Company Name" required />
            <.input field={@form[:business_type]} type="text" label="Business Type" required />
            <.input field={@form[:country]} type="text" label="Country" required />
            <.input
              field={@form[:primary_city]}
              type="text"
              label="Primary City / Base Location"
              required
            />
            <.input
              field={@form[:business_phone]}
              type="text"
              label="Business Phone Number"
              placeholder="0724989025"
              required
            />
            <.input
              field={@form[:brand_logo]}
              type="url"
              label="Brand / Logo URL (Optional)"
              placeholder="https://example.com/logo.png"
            />
            <.input
              field={@form[:base_office]}
              type="text"
              label="Base Office (Primary Hub)"
              placeholder="Defaults to Primary City if empty"
            />
            <.input
              field={@form[:branch_offices]}
              type="textarea"
              label="Branch Offices"
              placeholder="One office per line"
              rows="3"
            />
            <.input
              field={@form[:delivery_destinations]}
              type="textarea"
              label="Delivery Destinations"
              placeholder="One destination per line"
              rows="3"
            />
            <.input
              field={@form[:transfer_points]}
              type="textarea"
              label="Transfer Points"
              placeholder="One transfer point per line"
              rows="3"
            />
            <.input
              field={@form[:valid_routes]}
              type="textarea"
              label="Valid Routes"
              placeholder="Format: Origin -> Destination (one route per line)"
              rows="4"
            />
          </div>

          <div class=" pt-5">
            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
              <.button
                type="button"
                phx-click="cancel_onboarding"
              >
                Cancel
              </.button>

              <.button
                phx-disable-with="Done.."
                variant="primary"
              >
                Proceed
              </.button>
            </div>
          </div>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
