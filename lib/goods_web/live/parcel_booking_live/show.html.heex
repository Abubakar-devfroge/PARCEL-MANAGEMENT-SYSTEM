<Layouts.app flash={@flash}>
  <.header>
    <:actions>
      <.button navigate={~p"/parcel_bookings"}>
        <.icon name="hero-arrow-left" />
      </.button>

      <.button
        variant="primary"
        navigate={~p"/parcel_bookings/#{@parcel_booking.id}/edit?return_to=show"}
      >
        <.icon name="hero-pencil-square" /> Edit Record
      </.button>
    </:actions>
  </.header>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 shadow-md rounded-none border border-gray-200 ">
    <div class="px-4 sm:px-0 mb-6">
      <h3 class="text-base/7 font-semibold text-gray-900 font-mono">
        PARCEL NO: {@parcel_booking.parcel_number}
      </h3>
    </div>

    <div class="flow-root">
      <dl class="divide-y divide-gray-200 text-sm *:even:bg-gray-50  overflow-hidden">
        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">SENDER NAME:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.sender_name}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">SENDER PHONE:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.sender_phone}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">RECEIVER NAME:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.receiver_name}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">RECEIVER PHONE:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.receiver_phone}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">PARCEL DESTINATION:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.destination}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">PARCEL TYPE:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.parcel_type}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">PARCEL QUANTITY:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.quantity}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">PARCEL PRICE:</dt>
          <dd class="text-gray-700 sm:col-span-2">{@parcel_booking.price}</dd>
        </div>

        <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-3 sm:gap-6">
          <dt class="font-medium text-gray-900">DATE BOOKED:</dt>
          <dd class="text-gray-700 sm:col-span-2 leading-relaxed">
            {@parcel_booking.inserted_at |> format_eat_datetime()}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Layouts.app>
